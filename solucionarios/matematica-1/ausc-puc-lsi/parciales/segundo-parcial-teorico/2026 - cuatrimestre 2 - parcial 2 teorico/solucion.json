 "ejercicios": [
  {
   "numero": 1,
   "marcador": "Ejercicio 1: z · z̄ = |z|²",
   "enunciado": "Demuestre z · z̄ = |z|² y ejemplifique. ¿El resultado es ℂ? Explique.",
   "bloques": [
    {
     "seccion": "Demostración",
     "marcador": true,
     "bloques": [
      {
       "texto": "Hipótesis: z = a + bi, con a, b ∈ ℝ. Su conjugado es z̄ = a − bi y su módulo es |z| = √(a² + b²).",
       "color": "azul"
      },
      {
       "texto": "Tesis: z · z̄ = |z|²",
       "color": "azul"
      },
      {
       "seccion": "Miembro izquierdo",
       "bloques": [
        {
         "notas": "arriba",
         "pasos": [
          {
           "izq": "z · z̄",
           "der": "(a + bi) · (a − bi)"
          },
          {
           "rel": "=",
           "der": {
            "t": "a · a − a · bi + bi · a − bi · bi",
            "color": "producto"
           },
           "nota": "Propiedad distributiva",
           "notaColor": "producto"
          },
          {
           "rel": "=",
           "der": [
            {
             "t": "a²",
             "color": "producto"
            },
            " − ",
            {
             "t": "abi",
             "color": "producto"
            },
            " + ",
            {
             "t": "abi",
             "color": "producto"
            },
            " − ",
            {
             "t": "b²i²",
             "color": "producto"
            }
           ],
           "nota": "Resolver los productos",
           "notaColor": "producto"
          },
          {
           "rel": "=",
           "der": [
            "a² − b²i²"
           ],
           "nota": "Cancelar − abi + abi",
           "notaColor": "suma"
          },
          {
           "rel": "=",
           "der": [
            "a² − b² · ",
            {
             "t": "(−1)",
             "color": "producto"
            }
           ],
           "nota": "Reemplazar i² = −1",
           "notaColor": "producto"
          },
          {
           "rel": "=",
           "der": [
            "a² ",
            {
             "t": "+ b²",
             "color": "producto"
            }
           ],
           "nota": "Resolver el producto",
           "notaColor": "producto"
          }
         ]
        }
       ]
      },
      {
       "seccion": "Miembro derecho",
       "alLado": true,
       "bloques": [
        {
         "notas": "arriba",
         "pasos": [
          {
           "izq": "|z|²",
           "der": [
            "(",
            {
             "raiz": "a² + b²"
            },
            ")²"
           ]
          },
          {
           "rel": "=",
           "der": {
            "t": "a² + b²",
            "color": "producto"
           },
           "nota": [
            "La raíz y el cuadrado se",
            "cancelan (a² + b² ≥ 0)"
           ],
           "notaColor": "producto"
          }
         ]
        }
       ]
      },
      {
       "pasos": [
        {
         "izq": "a² + b²",
         "rel": "=",
         "der": [
          "a² + b² ",
          {
           "marca": "ok"
          }
         ]
        }
       ]
      },
      {
       "texto": "Los dos miembros son iguales. Por lo tanto z · z̄ = |z|² para todo z ∈ ℂ.",
       "color": "azul"
      }
     ]
    },
    {
     "seccion": "Ejemplo",
     "marcador": true,
     "bloques": [
      {
       "texto": "Sea z = 3 + 4i. Su conjugado es z̄ = 3 − 4i.",
       "color": "azul"
      },
      {
       "seccion": "Miembro izquierdo",
       "bloques": [
        {
         "notas": "arriba",
         "pasos": [
          {
           "izq": "z · z̄",
           "der": "(3 + 4i) · (3 − 4i)"
          },
          {
           "rel": "=",
           "der": {
            "t": "9 − 12i + 12i − 16i²",
            "color": "producto"
           },
           "nota": "Propiedad distributiva",
           "notaColor": "producto"
          },
          {
           "rel": "=",
           "der": "9 − 16i²",
           "nota": "Cancelar − 12i + 12i",
           "notaColor": "suma"
          },
          {
           "rel": "=",
           "der": [
            "9 − 16 · ",
            {
             "t": "(−1)",
             "color": "producto"
            }
           ],
           "nota": "Reemplazar i² = −1",
           "notaColor": "producto"
          },
          {
           "rel": "=",
           "der": [
            "9 ",
            {
             "t": "+ 16",
             "color": "producto"
            }
           ],
           "nota": "Resolver el producto",
           "notaColor": "producto"
          },
          {
           "rel": "=",
           "der": "25"
          }
         ]
        }
       ]
      },
      {
       "seccion": "Miembro derecho",
       "alLado": true,
       "bloques": [
        {
         "notas": "arriba",
         "pasos": [
          {
           "izq": "|z|²",
           "der": [
            "(",
            {
             "raiz": "3² + 4²"
            },
            ")²"
           ]
          },
          {
           "rel": "=",
           "der": [
            "(",
            {
             "raiz": "9 + 16"
            },
            ")²"
           ],
           "nota": "Resolver las potencias",
           "notaColor": "producto"
          },
          {
           "rel": "=",
           "der": [
            "(",
            {
             "raiz": "25"
            },
            ")²"
           ]
          },
          {
           "rel": "=",
           "der": {
            "t": "25",
            "color": "producto"
           },
           "nota": [
            "La raíz y el cuadrado",
            "se cancelan"
           ],
           "notaColor": "producto"
          }
         ]
        }
       ]
      },
      {
       "pasos": [
        {
         "izq": "25",
         "rel": "=",
         "der": [
          "25 ",
          {
           "marca": "ok"
          }
         ]
        }
       ]
      },
      {
       "pasos": [
        {
         "der": "(3 + 4i) · (3 − 4i) = |3 + 4i|² = 25",
         "caja": "azul"
        }
       ]
      }
     ]
    },
    {
     "seccion": "¿El resultado es ℂ?",
     "marcador": true,
     "bloques": [
      {
       "texto": "El resultado z · z̄ = a² + b² es siempre un número real y mayor o igual que 0, porque a y b son reales y sus cuadrados no son negativos.",
       "color": "azul"
      },
      {
       "texto": "Como ℝ ⊂ ℂ, también es un número complejo, pero con la parte imaginaria igual a 0: a² + b² = (a² + b²) + 0i. En el ejemplo, 25 = 25 + 0i.",
       "color": "azul"
      },
      {
       "pasos": [
        {
         "der": "z · z̄ ∈ ℝ (y z · z̄ ≥ 0) para todo z ∈ ℂ",
         "caja": "azul"
        }
       ]
      },
      {
       "texto": "Nota para el estudiante: multiplicar un número complejo por su conjugado siempre «borra» la parte imaginaria. Por eso se usa para dividir complejos: se multiplica arriba y abajo por el conjugado del denominador y el denominador queda real.",
       "color": "gris",
       "tam": "S"
      }
     ]
    }
   ]
  },
