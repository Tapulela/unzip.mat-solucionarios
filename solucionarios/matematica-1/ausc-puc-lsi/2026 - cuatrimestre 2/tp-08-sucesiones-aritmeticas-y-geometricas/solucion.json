    {
     "numero": "a",
     "enunciado": "3, 7, 11, 15...",
     "bloques": [
      {
       "texto": "Diferencias entre términos consecutivos:",
       "unir": true
      },
      {
       "pasos": [
        {
         "izq": "7 − 3",
         "der": "4"
        },
        {
         "izq": "11 − 7",
         "der": "4"
        },
        {
         "izq": "15 − 11",
         "der": "4"
