      { "texto": "Nota para el estudiante: los elementos de P(A) son los subconjuntos de A, o sea, X ∈ P(A) ⇔ X ⊆ A.", "color": "gris", "tam": "S" },
      { "pasos": [
        { "der": [ "1)  {a} ∈ A" ] },
        { "der": { "t": "      Falsa, porque los elementos de A son a, b, c y d.", "color": "azul" } },
        { "seccion": true, "der": [ "2)  {a} ∈ P(A)" ] },
        { "der": { "t": "      Verdadera, porque {a} ⊆ A.", "color": "azul" } },
        { "seccion": true, "der": [ "3)  ∅ ∈ P(A)" ] },
        { "der": { "t": "      Verdadera, porque ∅ ⊆ A.", "color": "azul" } },
        { "seccion": true, "der": [ "4)  ∅ ⊂ P(A)" ] },
        { "der": { "t": "      Verdadera, porque ∅ es subconjunto de cualquier conjunto.", "color": "azul" } },
        { "seccion": true, "der": [ "5)  b ∈ P(A)" ] },
        { "der": { "t": "      Falsa, porque b no es un conjunto. El que está en P(A) es {b}.", "color": "azul" } },
        { "seccion": true, "der": [ "6)  {a, {b, c}} ∈ P(A)" ] },
        { "der": { "t": "      Falsa, porque {b, c} ∉ A, y entonces {a, {b, c}} ⊄ A.", "color": "azul" } }
      ] },
      { "pasos": [ { "der": "Son verdaderas 2), 3) y 4).", "color": "azul", "caja": "azul" } ] }
     ]
    }
   ]
  },
