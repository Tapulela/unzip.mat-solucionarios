{
  "formato": "unzip.mat/solucion@1",
  "titulo": "TP de ejemplo — Resolución",
  "subtitulo": "Matemática 1 · Factorización, valor absoluto y sistemas",
  "meta": {
    "materia": "Matemática 1",
    "institucion": "_ejemplo",
    "anio": 2026,
    "tp": "Ejemplo",
    "fuente": "Ejercicios inventados para mostrar el formato",
    "autores": ["unzip.mat"],
    "estado": "borrador"
  },
  "estilo": { "fuente": "normal", "tam": "M", "notas": true },
  "ejercicios": [
    {
      "numero": 1,
      "enunciado": "Factorizar P(x) = 2x² − 2x − 12.",
      "bloques": [
        {
          "pasos": [
            { "izq": "P(x)", "der": "2x² − 2x − 12" },
            { "rel": "=", "der": [{ "t": "2", "color": "producto" }, "(x² − x − 6)"], "nota": "Sacar factor común 2", "notaColor": "producto" },
            { "der": ["a = ", { "t": "1", "color": "a" }, "    b = ", { "t": "−1", "color": "b" }, "    c = ", { "t": "−6", "color": "c" }], "nota": "Identificar a, b y c en x² − x − 6" },
            { "izq": "x₁,₂", "der": { "frac": [["−(", { "t": "−1", "color": "b" }, ") ± ", { "raiz": [{ "t": "(−1)", "color": "b" }, "² − 4·", { "t": "1", "color": "a" }, "·(", { "t": "−6", "color": "c" }, ")"] }], ["2·", { "t": "1", "color": "a" }]] }, "nota": "Fórmula cuadrática" },
            { "izq": "x₁,₂", "der": { "frac": [["1 ± ", { "raiz": { "t": "1 + 24", "color": "suma" } }], "2"] }, "nota": "Resolver las operaciones", "notaColor": "suma" },
            { "izq": "x₁,₂", "der": { "frac": [["1 ± ", { "raiz": { "t": "25", "color": "suma" } }], "2"] }, "nota": "Resolver la suma", "notaColor": "suma" },
            { "izq": "x₁,₂", "der": { "frac": [["1 ± ", { "t": "5", "color": "producto" }], "2"] }, "nota": "√25 = 5", "notaColor": "producto", "llave": true },
            { "rama": "x₁", "der": [{ "frac": ["1 + 5", "2"] }, " = 3"], "nota": "Calcular las dos raíces", "notaColor": "suma" },
            { "rama": "x₂", "der": [{ "frac": ["1 − 5", "2"] }, " = −2"] },
            { "seccion": true, "der": "Forma factorizada: a(x − x₁)(x − x₂)" },
            { "izq": "P(x)", "der": "2(x − 3)(x − (−2))", "nota": "Reemplazar a, x₁ y x₂", "notaColor": "producto" },
            { "izq": "P(x)", "der": "2(x − 3)(x + 2)", "nota": "Resolver los signos", "notaColor": "suma", "caja": "azul" }
          ]
        },
        { "texto": "Verificación: 2(x − 3)(x + 2) = 2(x² − x − 6) = 2x² − 2x − 12, que es P(x).", "color": "gris" }
      ]
    },
    {
      "numero": 2,
      "enunciado": "Resolver |2x − 1| < 3 y representar el conjunto solución en la recta real.",
      "bloques": [
        {
          "pasos": [
            { "der": "|2x − 1| < 3" },
            { "der": "−3 < 2x − 1 < 3", "nota": ["Propiedad: |u| < k ⇔ −k < u < k", "(con k > 0)"] },
            { "der": ["−3 ", { "t": "+ 1", "color": "suma" }, " < 2x − 1 ", { "t": "+ 1", "color": "suma" }, " < 3 ", { "t": "+ 1", "color": "suma" }], "nota": "Sumar 1 en los tres miembros", "notaColor": "suma" },
            { "der": "−2 < 2x < 4" },
            { "der": [{ "frac": ["−2", { "t": "2", "color": "producto" }] }, " < ", { "frac": ["2x", { "t": "2", "color": "producto" }] }, " < ", { "frac": ["4", { "t": "2", "color": "producto" }] }], "nota": ["Dividir por 2 en los tres miembros", "(es positivo: no cambia el sentido)"], "notaColor": "producto" },
            { "der": "−1 < x < 2" },
            { "der": "S = (−1, 2)", "caja": "azul" }
          ]
        },
        {
          "generador": "recta",
          "op": {
            "filas": [{ "texto": "(−1, 2)", "color": "#1971c2" }],
            "mostrarUnion": false, "mostrarResultado": false, "titulos": false, "largo": "corta"
          }
        }
      ]
    },
    {
      "numero": 3,
      "enunciado": "Dado el sistema x + y = 5, x − y = 1:",
      "items": [
        {
          "enunciado": "Resolverlo por reducción.",
          "bloques": [
            {
              "pasos": [
                { "der": { "sistema": [["x + y = 5"], ["x − y = 1"]] } },
                { "der": [{ "t": "2x", "color": "suma" }, " = ", { "t": "6", "color": "suma" }], "nota": "Sumar las dos ecuaciones (se cancela y)", "notaColor": "suma" },
                { "izq": "x", "der": { "frac": ["6", { "t": "2", "color": "producto" }] }, "nota": "Dividir por 2", "notaColor": "producto" },
                { "izq": "x", "der": "3" },
                { "izq": "y", "der": "5 − x", "nota": "Despejar y de la primera ecuación" },
                { "izq": "y", "der": ["5 − ", { "t": "3", "color": "producto" }], "nota": "Reemplazar x = 3", "notaColor": "producto" },
                { "izq": "y", "der": "2" },
                { "der": "Solución: (x, y) = (3, 2)", "caja": "azul" }
              ]
            }
          ]
        },
        {
          "enunciado": "Verificar la solución en las dos ecuaciones.",
          "bloques": [
            {
              "pasos": [
                { "der": { "tabla": [["x", "y", "x + y", "x − y"], ["3", "2", ["5 ", { "marca": "ok" }], ["1 ", { "marca": "ok" }]]] } }
              ]
            }
          ]
        }
      ]
    }
  ]
}
